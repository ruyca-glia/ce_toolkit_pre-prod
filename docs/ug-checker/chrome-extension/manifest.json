{
  "manifest_version": 3,
  "name": "CMS Knowledge Bank Tools",
  "version": "1.0.0",
  "description": "Fetch User Goal attributes from a CMS response.",
  "action": {
    "default_title": "CMS Knowledge Bank Tools",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://knowledge-bank.k8s-prod-na.finn.ai/*"]
}
